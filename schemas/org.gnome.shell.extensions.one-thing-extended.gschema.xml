<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.one-thing-extended" path="/org/gnome/shell/extensions/one-thing-extended/">
    <key name="show-settings-button-on-popup" type="b">
      <default>true</default>
    </key>
    <!-- Values: 0(Left), 1(Center), 2(Right) -->
    <key name="location-in-status-bar" type="i">
      <default>2</default>
      <range min="0" max="2"/>
    </key>
    <key name="index-in-status-bar" type="i">
      <default>0</default>
    </key>
    <key name="thing-value" type="s">
      <default>'Write One Thing'</default>
    </key>
    <!-- Values: manual, text-file -->
    <key name="task-provider" type="s">
      <default>'manual'</default>
    </key>
    <key name="text-file-path" type="s">
      <default>''</default>
    </key>
    <key name="text-file-preview-limit" type="i">
      <default>5</default>
      <range min="1" max="20"/>
    </key>
    <key name="panel-font-family" type="s">
      <default>''</default>
    </key>
    <key name="panel-font-color" type="s">
      <default>''</default>
    </key>
    <!-- 0 uses the GNOME Shell default font size -->
    <key name="panel-font-size" type="i">
      <default>0</default>
      <range min="0" max="96"/>
    </key>
    <key name="hot-key" type="b">
      <default>true</default>
    </key>
    <key type="as" name="activate-one-thing-extended">
      <default><![CDATA[['<Super>W']]]></default>
      <summary>Activate Onething</summary>
    </key>
  </schema>
</schemalist>
